TZ=Europe/Warsaw
DRY_RUN=true
ALLOW_REAL_SUBMIT=false
ALLOW_MOCK_SUBMIT=false
JOBHUNTER_ENABLED=true
MAX_APPLICATIONS_PER_DAY=20
AUTO_APPLY_MIN_SCORE=78
REVIEW_MIN_SCORE=60
STRETCH_MIN_SCORE=45
DISCOVERY_INTERVAL_MINUTES=60
DAILY_SUMMARY_HOUR=20
WEEKLY_FUNNEL_ENABLED=true
VACANCY_REVERIFY_BEFORE_CV=true
VACANCY_REVERIFY_BEFORE_SUBMIT=true
LOCAL_RADIUS_KM=30
EUROPE_NONLOCAL_AUTO_APPLY=false
RELOCATION_ASSUME_WILLING=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_FAST_MODEL=qwen3.5:4b
LLM_STRONG_MODEL=qwen3.5:4b
# Optional scoped CV models; blank inherits global fast/strong models.
# Real local comparison passed factual QA with the installed gemma4:e2b-it-qat.
CV_WRITER_MODEL=
CV_VERIFIER_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
BROWSER_SERVICE_TOKEN=
CORE_SERVICE_TOKEN=
POSTGRES_DB=jobhunter
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=
DATABASE_URL=
N8N_ENCRYPTION_KEY=
MAX_BROWSER_RECOVERY_ATTEMPTS=2
SCREENSHOT_RETENTION_DAYS=30
SESSION_RETENTION_HOURS=24
LOG_LEVEL=debug
ARTIFACT_DIR=data/cv-v2
ALLOW_MOCK_NETWORK=false
APPLICATION_DOMAIN_ALLOWLIST=
APPLICATION_DOMAIN_DENYLIST=
ANALYSIS_BATCH_SIZE=3
APPLICATION_FILL_ENABLED=false
BROWSER_SESSION_RETENTION_HOURS=48
SCREENSHOT_RETENTION_HOURS=168
QUEUE_INTERVAL_MINUTES=15
DISCOVERY_V2_ENABLED=true
CV_FACTORY_V2_ENABLED=true
READINESS_REAL_SUBMIT_LOCK=true
DASHBOARD_PORT=3020
# Set a private password of at least 16 characters. Never commit .env.
DASHBOARD_PASSWORD=
