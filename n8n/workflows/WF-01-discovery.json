{
  "id": "WF-01",
  "name": "WF-01 discovery",
  "nodes": [
    {
      "id": "manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "id": "subworkflow",
      "name": "Stage Input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        200
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "webhook",
      "name": "Stage Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        400
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "jobhunter/stage/1",
        "authentication": "headerAuth",
        "responseMode": "lastNode"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "jobhunter-core",
          "name": "JobHunter internal secret"
        }
      }
    },
    {
      "id": "schedule",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        -200
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 60
            }
          ]
        }
      }
    },
    {
      "id": "stage",
      "name": "Execute Stage 1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://core:3000/stages/1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body || {}) }}",
        "options": {
          "timeout": 420000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "jobhunter-core",
          "name": "JobHunter internal secret"
        }
      }
    },
    {
      "id": "next",
      "name": "Queue Stage 2",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        600,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "WF-02",
          "mode": "id"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": false
        }
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Execute Stage 1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Stage Input": {
      "main": [
        [
          {
            "node": "Execute Stage 1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Stage Webhook": {
      "main": [
        [
          {
            "node": "Execute Stage 1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule": {
      "main": [
        [
          {
            "node": "Execute Stage 1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Stage 1": {
      "main": [
        [
          {
            "node": "Queue Stage 2",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Warsaw",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "pinData": {},
  "tags": []
}
