{
  "name": "jobhunter-n8n",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "start": "node --env-file=.env services/core/server.mjs",
    "migrate": "node --env-file=.env scripts/migrate.mjs",
    "health": "node --env-file=.env scripts/healthcheck.mjs",
    "dashboard": "node --env-file=.env services/dashboard/server.mjs",
    "dashboard:build": "npm --prefix services/dashboard/web run build",
    "discovery:real": "node --env-file=.env scripts/discovery-market.mjs",
    "ats:real": "node --env-file=.env scripts/ats-real-benchmark.mjs",
    "workflows": "node scripts/generate-workflows.mjs"
  },
  "dependencies": {
    "@lmstudio/sdk": "^2.0.0",
    "ajv": "^8.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "playwright": "^1.55.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17"
  }
}
