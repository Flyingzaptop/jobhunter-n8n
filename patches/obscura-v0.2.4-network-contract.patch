new file mode 100644
index 0000000..cf2f0af
--- /dev/null
+++ b/crates/obscura-browser/src/network_interception.rs
@@ -0,0 +1,23 @@
+use std::collections::HashMap;
+use base64::{Engine as _,engine::general_purpose::STANDARD};
+use obscura_net::{RequestInfo,Response};
+use obscura_net::interceptor::{RequestInterceptor,InterceptAction};
+use obscura_js::ops::{InterceptedRequest,InterceptResolution};
+pub struct NativeNetworkInterceptor {pub page_id:String,pub tx:tokio::sync::mpsc::UnboundedSender<InterceptedRequest>}
+#[async_trait::async_trait]
+impl RequestInterceptor for NativeNetworkInterceptor {
+ async fn intercept(&self,request:&RequestInfo)->InterceptAction {
+  let (resolver,receiver)=tokio::sync::oneshot::channel();
+  let message=InterceptedRequest{request_id:format!("native-{}",uuidless_id()),page_id:self.page_id.clone(),url:request.url.to_string(),method:request.method.clone(),headers:request.headers.clone(),body:request.body.clone(),resource_type:format!("{:?}",request.resource_type),resolver};
+  if self.tx.send(message).is_err(){return InterceptAction::Block;}
+  match receiver.await {
+   Ok(InterceptResolution::Fulfill{status,headers,body,body_base64})=>{
+    let bytes=if body_base64.is_empty(){body.into_bytes()}else{match STANDARD.decode(body_base64){Ok(bytes)=>bytes,Err(_)=>return InterceptAction::Block}};
+    InterceptAction::Fulfill(Response{url:request.url.clone(),status,headers,body:bytes,redirected_from:Vec::new()})
+   },
+   Ok(InterceptResolution::Continue{url:None,method:None,headers,body:None})=>headers.map(InterceptAction::ModifyHeaders).unwrap_or(InterceptAction::Continue),
+   _=>InterceptAction::Block,
+  }
+ }
+}
+fn uuidless_id()->u64{use std::sync::atomic::{AtomicU64,Ordering};static ID:AtomicU64=AtomicU64::new(0);ID.fetch_add(1,Ordering::Relaxed)}
